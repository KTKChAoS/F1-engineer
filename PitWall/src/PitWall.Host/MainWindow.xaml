<Window x:Class="PitWall.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PitWall — F1 25 Race Engineer"
        Height="720" Width="1100"
        Background="{StaticResource BgBrush}"
        Loaded="OnLoaded" Closed="OnClosed">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="PITWALL" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="F1 25 listener" Margin="16,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="16"/>
            <Ellipse x:Name="StatusDot" Width="14" Height="14" Margin="18,4,8,0" Fill="#8A93A3"/>
            <TextBlock x:Name="StatusText" Text="Waiting for packets" VerticalAlignment="Center" FontSize="16"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Start recording" Click="OnStartRecording"/>
            <Button Content="Stop recording" Click="OnStopRecording"/>
            <Button Content="Replay file…" Click="OnReplay"/>
            <Button Content="Add firewall rules" Click="OnFirewall"/>
            <CheckBox x:Name="CallSoundCheck" Content="Call sound" Margin="8,0,8,0" VerticalAlignment="Center"/>
            <CheckBox x:Name="CallSpeechCheck" Content="Speak calls" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="Call audio" VerticalAlignment="Center" Margin="4,0,6,0"/>
            <ComboBox x:Name="CallOutputDeviceCombo" Width="190" Height="30" VerticalAlignment="Center" SelectionChanged="OnCallOutputDeviceChanged"/>
            <TextBlock x:Name="RecordStatus" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Connection" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="IpText"/>
                    <TextBlock x:Name="PpsText" Margin="0,8,0,0"/>
                    <TextBlock x:Name="AgeText"/>
                    <TextBlock x:Name="FormatText"/>
                    <TextBlock x:Name="CountsText" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="FormatWarning" Foreground="{StaticResource WarnBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="PS5: Telemetry On, Broadcast On, UDP Format 2025, port 20777."
                               Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="Player" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="SessionText"/>
                    <TextBlock x:Name="SpeedText" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                    <TextBlock x:Name="GearText" FontSize="22"/>
                    <TextBlock x:Name="InputsText" Margin="0,8,0,0"/>
                    <TextBlock x:Name="LapText" Margin="0,8,0,0"/>
                    <TextBlock x:Name="TyreText"/>
                    <TextBlock x:Name="EnergyText"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
