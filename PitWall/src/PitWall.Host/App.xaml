<Application x:Class="PitWall.Host.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#0E1116"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171C24"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EEF7"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A93A3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#E10600"/>
        <SolidColorBrush x:Key="OkBrush" Color="#3DDC97"/>
        <SolidColorBrush x:Key="WarnBrush" Color="#F5C518"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#232A35"/>
            <Setter Property="Foreground" Value="#E8EEF7"/>
            <Setter Property="BorderBrush" Value="#3A4454"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#232A35"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#3A4454"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2B3441"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#303B4A"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
